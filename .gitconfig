[user]
	email = razum@qruto.to
	name = Slava Razum
	signingkey = ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIJz3qPAvslhdazUEWWNpYOmmIMq4b9ZtNvyelylEmLAK
[core]
	excludesfile = ~/Development/.dotfiles/.gitignore-global
	autocrlf = input
	editor = code --wait
[init]
	defaultBranch = main
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[pull]
	rebase = true
[fetch]
	prune = true
[rebase]
	autostash = true
[merge]
	conflictstyle = zdiff3
	tool = vscode
[rerere]
	enabled = true
[branch]
	sort = -committerdate
[gpg]
	format = ssh
[gpg "ssh"]
	program = /Applications/1Password.app/Contents/MacOS/op-ssh-sign
	allowedSignersFile = /Users/slavarazum/.config/git/allowed_signers
[commit]
	gpgsign = true
[tag]
	forceSignAnnotated = true
[push]
	autoSetupRemote = true
[diff]
	tool = vscode
[difftool "vscode"]
	cmd = code --wait --diff \"$LOCAL\" \"$REMOTE\"
[difftool]
	prompt = false
[mergetool "vscode"]
	cmd = code --wait --merge \"$REMOTE\" \"$LOCAL\" \"$BASE\" \"$MERGED\"
[mergetool]
	prompt = false
[credential "https://github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
