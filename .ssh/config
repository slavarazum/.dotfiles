# ============================================
# Mode switcher (controlled by $SSH_MODE)
# ============================================

# When SSH_MODE=yubi → force YubiKey
Match host * exec "[ \"$SSH_MODE\" = yubi ]"
	IdentityAgent none
	IdentityFile ~/.ssh/id_ed25519_sk
	IdentitiesOnly yes

# Default → 1Password
Host *
	IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
